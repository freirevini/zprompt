# Vertex AI — usado só pelo servidor local. Copie para .env e preencha.
GOOGLE_CLOUD_PROJECT=
VERTEX_LOCATION=global
# Host da API. Vazio: aiplatform.googleapis.com em global; aiplatform.us.rep.googleapis.com e aiplatform.eu.rep.googleapis.com em us e eu.
VERTEX_API_HOST=
GEMINI_MODEL=gemini-3.8-flash
# Modelo do agente seletor de skills. Vazio usa GEMINI_MODEL.
GEMINI_SKILLS_MODEL=
# Autenticação: Application Default Credentials (gcloud auth application-default login)
# ou conta de serviço apontada por GOOGLE_APPLICATION_CREDENTIALS. Nunca commitar a chave.
GOOGLE_APPLICATION_CREDENTIALS=

# Servidor local
ZPROMPT_API_PORT=4300
# Pasta do projeto cujas skills serão lidas. Vazio: detecta pela pasta onde o servidor foi iniciado.
ZPROMPT_PROJECT_DIR=
# Pastas extras com skills, separadas por ":" no macOS e Linux ou ";" no Windows.
ZPROMPT_SKILL_ROOTS=
# 1 desliga a linha de log por pedido do servidor.
ZPROMPT_QUIET=
