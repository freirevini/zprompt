{
  "name": "zprompt-skills-selector",
  "promptVersion": "1.2.0",
  "schemaVersion": "1.0.0",
  "profile": "classificacao",
  "model": {
    "idEnv": "GEMINI_SKILLS_MODEL",
    "fallbackIdEnv": "GEMINI_MODEL",
    "default": "gemini-3.8-flash",
    "locationEnv": "VERTEX_LOCATION",
    "defaultLocation": "global",
    "verifiedAt": "2026-10-23"
  },
  "files": {
    "systemInstruction": "agent/skills-selector/system-instruction.md",
    "responseSchema": "agent/skills-selector/response-schema.json"
  },
